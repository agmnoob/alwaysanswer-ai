# =============================================================================
# ALWAYSANSWER AI - HVAC Inbound Agent Configuration
# Copy to .env and fill in your API keys
# =============================================================================

# --- Core LLM (Choose one) ---
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI
# OPENAI_API_KEY=sk-...
# Or use OpenRouter for multiple models
# OPENROUTER_API_KEY=sk-or-...

# --- STT (Speech-to-Text) ---
# Deepgram (recommended for pipeline mode)
DEEPGRAM_API_KEY=...
# AssemblyAI
# ASSEMBLYAI_API_KEY=...
# Cartesia STT
# CARTESIA_API_KEY=...

# --- TTS (Text-to-Speech) ---
# ElevenLabs (recommended for quality)
ELEVENLABS_API_KEY=...
# Cartesia
# CARTESIA_API_KEY=...
# OpenAI TTS
# OPENAI_API_KEY=...

# --- Telephony ---
# Twilio (recommended)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# For production: set your public webhook URL
# WEBHOOK_URL=https://your-domain.com

# --- Dashboard ---
DASHBOARD_TOKEN=change-me-in-production

# --- Stripe Checkout (server-side; secret key never exposed to browser) ---
# 1) Create prices in Stripe Dashboard (Test mode first): Products -> recurring $197 / $497
# 2) Copy the Price IDs (price_...) below.
# 3) Get secret key from Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_STARTER=price_xxxStarter
STRIPE_PRICE_GROWTH=price_xxxGrowth
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- Google Calendar (owner availability + direct demo booking) ---
# 1) Create OAuth2 Desktop client in Google Cloud, save as credentials.json
# 2) Run: python3 setup_calendar_auth.py  (one-time browser click-through)
GOOGLE_CALENDAR_ID=primary
OWNER_EMAIL=you@yourdomain.com
CALENDAR_TZ=America/Los_Angeles

# Booking link fallback (no longer primary — Aria books directly on your calendar)
BOOKING_LINK=https://calendar.app.google/YOUR_APPOINTMENT_PAGE

# --- Optional: Custom LLM endpoint (Ollama, vLLM, etc.) ---
# CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
# CUSTOM_LLM_API_KEY=local
